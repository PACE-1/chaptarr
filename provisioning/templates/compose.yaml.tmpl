# Generated by chaptarr-provision for ABS user "{{username_comment}}" (slug {{slug}}).
# Re-rendered on every `create` run: change templates/compose.yaml.tmpl or the config instead.
# The API key comes from .env next to this file (mode 0600), never from this file.
name: {{project}}

services:
  chaptarr:
    image: {{image}}
    container_name: {{container_name}}
    hostname: {{container_name}}
    restart: unless-stopped
    environment:
{{environment}}
      Chaptarr__Auth__ApiKey: ${CHAPTARR_API_KEY:?CHAPTARR_API_KEY missing from .env}
    volumes:
{{volumes}}
    networks:
      - shared
    # No published ports: the instance is reachable only on the shared network
    # (ABS plugin, Prowlarr, the provisioner).
    labels:
      io.chaptarr.provision.slug: {{slug_label}}
      io.chaptarr.provision.managed: "true"

networks:
  shared:
    name: {{network}}
    external: true
